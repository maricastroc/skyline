+const unitWidth = (s: Series) => FACE / Math.min(Math.max(s.perRow, 2), 8);
+function unitFloors(s: Series, k: number): number {
+  const [w, h] = s.sizes[k % s.sizes.length];
+  return Math.max(1, Math.min(18, Math.round(((unitWidth(s) * h) / w - STREET_FLOOR) / FLOOR)));
+}
+
+function unitProgram(ctx: ComposeCtx, t: Territory, comp: Comp, salt: number, floors: number, width: number): Program {
+  const P = prog(ctx, t, comp, salt);
