+  let outer: Rect | null = null;
+  let ink = 0;
+  const marks: Array<[number, number, number, number, number]> = [];
+  for (const k of scopeOf(nodes, scope.roots, scope.excluded)) {
+    const n = nodes[k];
+    if (!n.box) continue;
+    const r: Rect = [n.box[0], n.box[1], n.box[0] + n.box[2], n.box[1] + n.box[3]];
+    outer = outer ? [Math.min(outer[0], r[0]), Math.min(outer[1], r[1]), Math.max(outer[2], r[2]), Math.max(outer[3], r[3])] : r;
+    ink += n.ink ?? 0;
+    if ((n.ink ?? 0) > 0 || n.ownChars > 0) marks.push([...r, n.selfWeight]);
+  }
+  const total = marks.reduce((s, m) => s + m[4], 0);
+  const at = (col: 0 | 1 | 2 | 3, f: number) => {
+    const sorted = marks.map((m) => [m[col], m[4]] as const).sort((a, b) => a[0] - b[0]);
+    let acc = 0;
+    for (const [v, w] of sorted) if ((acc += w) >= f * total) return v;
+    return sorted[sorted.length - 1][0];
+  };
+  const core: Rect | null = marks.length >= 3 ? [at(0, 0.1), at(1, 0.1), at(2, 0.9), at(3, 0.9)] : null;
+  const rect = core && core[2] > core[0] && core[3] > core[1] ? core : outer;
+  const area = rect ? (rect[2] - rect[0]) * (rect[3] - rect[1]) : 0;
+  return { rect, coverage: area ? Math.min(1, ink / area) : 0 };
+}
+
+export function columnsOf(plan: Plan, lots: number[]): number[][] | null {
+  const big = plan.territories.map((t, i) => ({ i, rect: t.frame?.rect ?? null })).filter((t): t is { i: number; rect: Rect } => lots[t.i] >= MIN_LOTS && t.rect !== null);
+  if (big.length < 2) return null;
+  const span = Math.max(Math.max(...big.map((t) => t.rect[2])) - Math.min(...big.map((t) => t.rect[0])), 1);
+  const cols: Array<{ x0: number; x1: number; members: Array<{ i: number; rect: Rect }> }> = [];
+  for (const t of big.filter((b) => (b.rect[2] - b.rect[0]) / span < SPANNING).sort((a, b) => a.rect[0] - b.rect[0])) {
+    const c = cols.find((k) => Math.min(k.x1, t.rect[2]) - Math.max(k.x0, t.rect[0]) > OVERLAP * Math.min(k.x1 - k.x0, t.rect[2] - t.rect[0]));
+    if (c) {
+      c.x0 = Math.min(c.x0, t.rect[0]);
+      c.x1 = Math.max(c.x1, t.rect[2]);
+      c.members.push(t);
+    } else cols.push({ x0: t.rect[0], x1: t.rect[2], members: [t] });
+  }
+  const beside = (a: Rect, b: Rect) => Math.min(a[3], b[3]) - Math.max(a[1], b[1]) >= OVERLAP * Math.min(a[3] - a[1], b[3] - b[1]);
+  const real = cols.filter((c) => cols.some((o) => o !== c && c.members.some((m) => o.members.some((n) => beside(m.rect, n.rect)))));
+  if (real.length < 2) return null;
+  return real.sort((a, b) => a.x0 - b.x0).map((c) => c.members.map((m) => m.i));
+}
+
+export function bareOf(plan: Plan, lots: number[]): Set<number> {
+  const out = new Set<number>();
+  if (plan.shell) return out;
+  plan.territories.forEach((t, i) => {
+    const f = t.frame;
+    if (!f?.rect || lots[i] < MIN_LOTS) return;
+    if (f.coverage < BARE && t.metrics.chars / lots[i] < FEW_CHARS && t.metrics.images === 0) out.add(i);
+  });
+  return out;
+}
+
+export function allocateSpatial(plan: Plan): Allocation {
+  const base = allocate(plan);
+  const bare = bareOf(plan, base.lots);
+  const open = bare.size ? { open: bare } : {};
+  const cols = columnsOf(plan, base.lots);
+  if (!cols) return { ...base, ...open };
+
+  const colOf = new Map<number, number>();
+  cols.forEach((c, k) => c.forEach((i) => colOf.set(i, k)));
+  const size = cols.map((c) => c.reduce((s, i) => s + base.lots[i], 0));
+  const main = size.indexOf(Math.max(...size));
+  const band = (territory: number) => colOf.get(territory) ?? main;
+  const need = cols.map((_, k) => base.segments.reduce((s, g) => s + (band(g.territory) === k ? g.count : 0), 0));
+
+  const sweep: number[] = [];
+  for (let qx = 0; qx < N / 2; qx++)
+    for (let qz = 0; qz < N / 2; qz++)
+      for (const [dx, dz] of [[0, 0], [1, 0], [0, 1], [1, 1]]) sweep.push((qx * 2 + dx) * N + qz * 2 + dz);
+  const bandOf = new Int32Array(LOT_TOTAL).fill(main);
+  let at = 0;
+  cols.forEach((_, k) => {
+    for (let n = 0; n < need[k] && at < sweep.length; n++) bandOf[sweep[at++]] = k;
+  });
+
+  const spiral = base.path.map(([x, z]) => x * N + z);
+  const path: Array<[number, number]> = [];
+  const segments: Segment[] = [];
+  cols.forEach((_, k) => {
+    const order = (k === main ? spiral : sweep).filter((c) => bandOf[c] === k);
+    let j = 0;
+    for (const g of base.segments) {
+      if (band(g.territory) !== k) continue;
+      segments.push({ ...g, from: path.length });
+      for (let n = 0; n < g.count && j < order.length; n++, j++) path.push([Math.floor(order[j] / N), order[j] % N]);
+    }
+  });
+  const owner = new Int32Array(LOT_TOTAL).fill(-1);
+  segments.forEach((s, si) => {
+    for (let k = s.from; k < s.from + s.count && k < path.length; k++) owner[path[k][0] * N + path[k][1]] = si;
+  });
+  return { path, owner, segments, lots: base.lots, ...open };
+}
