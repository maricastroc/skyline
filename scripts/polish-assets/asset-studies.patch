+/** STUDY: the blank state of a façade screen (no text from the page), three treatments. */
+function blankScreenStudy(kit: Kit, u0: number, u1: number, y0: number, y1: number, accent: RGB) {
+  const W = u1 - u0;
+  const H = y1 - y0;
+  const metal: RGB = [0.22, 0.23, 0.25];
+  if (SCREEN_STUDY === "a") {
+    // A · display off: a graphite bezel, dark glass with a hint of the brand colour, and a
+    // stepped pixel-art reflection; a tiny standby light at night.
+    const glass = mix([0.07, 0.09, 0.13], accent, 0.14);
+    kit.span(u0 - 0.08, u1 + 0.08, y0 - 0.08, y1 + 0.08, 0, 0.09, metal);
+    kit.span(u0, u1, y0, y1, 0.09, 0.1, glass);
+    const shine = mix(glass, kit.palette.sky.top, 0.42);
+    const steps = 5;
+    for (let i = 0; i < steps; i++) {
+      const a = u0 + W * (0.12 + i * 0.075);
+      const b = a + W * 0.17;
+      const ya = y0 + (H * i) / steps;
+      // Night: the reflection catches the street's light faintly, so the glass reads, not a hole.
+      if (kit.night) {
+        kit.glow(a + W * 0.06, ya, 0.103, W * 0.12, H / steps, 0.004, shine, 0.35);
+        kit.glow(b + W * 0.0175, ya, 0.103, W * 0.035, H / steps, 0.004, shine, 0.2);
+      } else {
+        kit.span(a, a + W * 0.12, ya, ya + H / steps, 0.1, 0.105, shine);
+        kit.span(b, b + W * 0.035, ya, ya + H / steps, 0.1, 0.105, mix(glass, shine, 0.6));
+      }
+    }
+    if (kit.night) kit.glow(u1 + 0.02, y0 - 0.06, 0.095, 0.03, 0.03, 0.01, accent, 1.6);
+    return;
+  }
+  if (SCREEN_STUDY === "b") {
+    // B · modular LED wall: cabinets on a dark frame, the page's accent in rows lightening
+    // upward (fixed, not random).
+    kit.span(u0 - 0.05, u1 + 0.05, y0 - 0.05, y1 + 0.05, 0, 0.08, [0.1, 0.1, 0.12]);
+    const cols = Math.max(3, Math.round(W / 0.34));
+    const rows = Math.max(2, Math.round(H / 0.34));
+    const gap = 0.025;
+    for (let r = 0; r < rows; r++) {
+      const t = rows === 1 ? 0.5 : r / (rows - 1);
+      const c = mix(darkOf(accent, 0.22), mix(accent, white, 0.3), t);
+      for (let k = 0; k < cols; k++) {
+        const a = u0 + (W * k) / cols + gap / 2;
+        const yb = y0 + (H * r) / rows + gap / 2;
+        kit.glow(a + (W / cols - gap) / 2, yb, 0.085, W / cols - gap, H / rows - gap, 0.01, c, kit.night ? 1.25 : 0.7);
+      }
+    }
+    return;
+  }
+  // C · outdoor structure: a deep frame around a panel in the page's accent, a service catwalk
+  // with a rail below and three floodlights on it washing the panel upward (lamps below: their
+  // shadows fall off the panel). The panel stays emissive: a lit box in a grazing sun shows the
+  // renderer's shadow dither.
+  const panel = mix(accent, white, 0.22);
+  const frame: RGB = [0.34, 0.35, 0.38];
+  kit.span(u0, u1, y0, y1, 0, 0.09, frame);
+  kit.glow((u0 + u1) / 2, y0, 0.095, W, H, 0.01, panel, kit.night ? 0.5 : 0.45);
+  kit.span(u0 - 0.07, u1 + 0.07, y1, y1 + 0.07, 0, 0.17, frame);
+  kit.span(u0 - 0.07, u1 + 0.07, y0 - 0.07, y0, 0, 0.17, frame);
+  kit.span(u0 - 0.07, u0, y0, y1, 0, 0.17, frame);
+  kit.span(u1, u1 + 0.07, y0, y1, 0, 0.17, frame);
+  kit.span(u0 - 0.15, u1 + 0.15, y0 - 0.16, y0 - 0.12, 0, 0.34, metal);
+  kit.span(u0 - 0.15, u1 + 0.15, y0 - 0.12, y0 + 0.08, 0.32, 0.34, [0.2, 0.2, 0.22], Surf.RAIL);
+  for (const f of [0.18, 0.5, 0.82]) {
+    const u = u0 + W * f;
+    kit.box(u, y0 - 0.12, 0.26, 0.1, 0.06, 0.07, metal);
+    kit.glow(u, y0 - 0.06, 0.25, 0.08, 0.012, 0.05, kit.palette.lamp, kit.night ? 2 : 0.2);
+  }
+  if (kit.night) kit.glow((u0 + u1) / 2, y0, 0.103, W, H * 0.32, 0.005, mix(panel, kit.palette.lamp, 0.35), 0.9);
+}
