+/**
+ * STUDY: the rooftop HVAC cluster, three treatments. Same pad position and width, same unit
+ * count; none has the floating duct.
+ */
+function hvacStudy(kit: Kit, cx0: number, cw: number, cz: number, y: number, n: number, steel: RGB, P: Program) {
+  const galv = mix(steel, white, 0.5);
+  const dark = darkOf(steel, 0.5);
+  const uw = Math.min(0.62, cw / n - 0.12);
+  const xs = Array.from({ length: n }, (_, i) => cx0 + (cw * (i + 0.5)) / n);
+  if (HVAC_STUDY === "a") {
+    // A · packaged condensers: light cabinets on a light pad, a darker louvre panel on the
+    // street side, one or two fans flush on top.
+    kit.box(cx0 + cw / 2, y, cz, cw - 0.06, 0.04, 0.62, mix(steel, white, 0.3));
+    for (const x of xs) {
+      kit.box(x, y + 0.04, cz, uw, 0.32, 0.48, galv);
+      kit.span(x - uw / 2 + 0.04, x + uw / 2 - 0.04, y + 0.08, y + 0.3, cz + 0.24, cz + 0.255, darkOf(galv, 0.3));
+      const fans = uw >= 0.5 ? 2 : 1;
+      const fd = Math.min(0.3, uw / fans - 0.07);
+      for (let f = 0; f < fans; f++) kit.cyl(x - uw / 2 + (uw * (f + 0.5)) / fans, y + 0.36, cz, fd, 0.02, fd, dark);
+    }
+    return;
+  }
+  if (HVAC_STUDY === "b") {
+    // B · condensing cabinets with the fan on the face: upright, shallower boxes, a ringed fan
+    // grille on the street side, on two low rails.
+    kit.box(cx0 + cw / 2, y, cz - 0.1, cw - 0.06, 0.05, 0.06, dark);
+    kit.box(cx0 + cw / 2, y, cz + 0.1, cw - 0.06, 0.05, 0.06, dark);
+    for (const x of xs) {
+      kit.box(x, y + 0.05, cz, uw, 0.4, 0.34, galv);
+      kit.box(x, y + 0.45, cz, uw + 0.02, 0.03, 0.36, mix(galv, white, 0.25));
+      const fd = Math.min(0.32, uw - 0.12);
+      kit.cyl(x, y + 0.25, cz + 0.17, fd, 0.02, fd, darkOf(galv, 0.2), { rotX: Math.PI / 2 });
+      kit.cyl(x, y + 0.25, cz + 0.17, fd * 0.72, 0.03, fd * 0.72, dark, { rotX: Math.PI / 2 });
+    }
+    return;
+  }
+  // C · equipment screen: a louvred enclosure in the parapet's colour hides the plant; only the
+  // fans show over its rim.
+  const sc = trimOf(P.wall);
+  const xa = cx0 - 0.06;
+  const xb = cx0 + cw + 0.06;
+  const za = cz - 0.37;
+  const zb = cz + 0.37;
+  const t = 0.04;
+  const hS = 0.36;
+  kit.span(xa, xb, y, y + 0.03, za, zb, darkOf(steel, 0.25));
+  for (const x of xs) {
+    kit.box(x, y + 0.03, cz, uw, 0.27, 0.46, galv);
+    kit.cyl(x, y + 0.3, cz, Math.min(0.3, uw - 0.12), 0.02, Math.min(0.3, uw - 0.12), dark);
+  }
+  kit.span(xa, xb, y, y + hS, zb - t, zb, sc, Surf.GRILLE);
+  kit.span(xa, xb, y, y + hS, za, za + t, sc, Surf.GRILLE);
+  kit.span(xa, xa + t, y, y + hS, za, zb, sc, Surf.GRILLE);
+  kit.span(xb - t, xb, y, y + hS, za, zb, sc, Surf.GRILLE);
+}
